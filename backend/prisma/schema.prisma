generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  personalNumber String?
  securityUnit   String?
  region         String?
  regionChief    String?
  title          String?
  createdAt DateTime @default(now())
  receptions Reception[]
  distributions Distribution[]
  logs      Log[]
  createdReceipts  DeliveryReceipt[] @relation("ReceiptCreator")
  approvedReceipts DeliveryReceipt[] @relation("ReceiptApprover")
}

model Item {
  id                Int       @id @default(autoincrement())
  name              String
  sku               String    @unique
  category          String?   // مثال: طب، مساعدات، معدات
  description       String?
  quantity          Int       @default(0)
  lowStockThreshold Int?
  securityUnit      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  receptionItems    ReceptionItem[]
  distributionItems DistributionItem[]
}

model Reception {
  id                Int             @id @default(autoincrement())
  reference         String          @unique
  referenceNumber   String?
  referenceType     String?         // نوع المرجع: فاتورة، توصيل، إيصال، إلخ
  referenceDate     DateTime?
  notes             String?
  supplier          Entity?         @relation(fields: [supplierId], references: [id])
  supplierId        Int?
  collector         Employee?       @relation(fields: [collectorId], references: [id])
  collectorId       Int?
  user              User            @relation(fields: [userId], references: [id])
  userId            Int
  securityUnit      String?
  createdAt         DateTime        @default(now())
  items             ReceptionItem[]
}

model ReceptionItem {
  id          Int       @id @default(autoincrement())
  reception   Reception @relation(fields: [receptionId], references: [id])
  receptionId Int
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      Int
  quantity    Int
  adminNumber String?
}

model Distribution {
  id              Int               @id @default(autoincrement())
  reference       String            @unique
  referenceType   String?
  referenceNumber String?
  referenceDate   DateTime?
  deliveredByName String?
  notes           String?
  user            User              @relation(fields: [userId], references: [id])
  userId          Int
  beneficiary     Entity?           @relation(fields: [beneficiaryId], references: [id])
  beneficiaryId   Int?
  assignedTo      Employee?         @relation(fields: [assignedToId], references: [id])
  assignedToId    Int?
  securityUnit    String?
  createdAt       DateTime          @default(now())
  items           DistributionItem[]
  receipt         DeliveryReceipt?
}

model DistributionItem {
  id             Int            @id @default(autoincrement())
  distribution   Distribution   @relation(fields: [distributionId], references: [id])
  distributionId Int
  item           Item           @relation(fields: [itemId], references: [id])
  itemId         Int
  quantity       Int
  serialNumber   String?
  adminNumber    String?
  condition      ItemCondition  @default(NEW)
  notes          String?
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  table     String
  recordId  Int?
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  securityUnit String?
  createdAt DateTime @default(now())
}

model Entity {
  id              Int       @id @default(autoincrement())
  name            String
  type            EntityType
  category        String    @default("OTHER")
  subCategory     String?
  phone           String
  unitHead        String?
  unitHeadPhone   String?
  securityUnit    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employees       Employee[]
  distributions   Distribution[]
  receptionsSent  Reception[]  // جهات مرسلة
  vehicles        Vehicle[]
  projects        Project[]
}

model Employee {
  id            Int            @id @default(autoincrement())
  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId      Int
  rank          String
  name          String
  surname       String
  number        String
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  distributions        Distribution[]
  receptionsCollected  Reception[]
}

enum Role {
  ADMIN
  SECTION_CHIEF
  USER
  REGION_CHIEF
  DISTRICT_MANAGER
}

enum EntityType {
  SUPPLIER
  BENEFICIARY
}

enum ReceiptStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum ItemCondition {
  NEW
  USED
  NEEDS_MAINTENANCE
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    Int?
  actorEmail  String?
  actorId     Int?
  details     String?
  ip          String?
  createdAt   DateTime @default(now())
}

enum VehicleStatus {
  OPERATIONAL
  BROKEN
}

enum BudgetState {
  active
  expired
  closed
}

model Budget {
  id             Int              @id @default(autoincrement())
  name           String
  department     String
  amount         Float
  startDate      String
  endDate        String
  status         BudgetState      @default(active)
  notes          String?
  createdBy      String?
  securityUnit   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  expenses       BudgetExpense[]
  supplyRequests SupplyRequest[]
}

model SupplyRequest {
  id          Int      @id @default(autoincrement())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    Int
  title       String
  supplier    String?
  notes       String?
  attachments String   @default("[]")
  createdBy   String?
  createdAt   DateTime @default(now())
}

model BudgetExpense {
  id            Int      @id @default(autoincrement())
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId      Int
  date          String
  supplier      String
  invoiceNumber String?
  amount        Float
  notes         String?
  attachments   String   @default("[]")
  addedBy       String?
  addedAt       DateTime @default(now())
}

model DeliveryReceipt {
  id             Int           @id @default(autoincrement())
  serialNumber   String        @unique
  distribution   Distribution  @relation(fields: [distributionId], references: [id])
  distributionId Int           @unique
  status         ReceiptStatus @default(DRAFT)
  issuedAt       DateTime      @default(now())
  approvedAt     DateTime?
  approvedById   Int?
  approvedBy     User?         @relation("ReceiptApprover", fields: [approvedById], references: [id])
  cancelledAt    DateTime?
  cancelledById  Int?
  cancelledByEmail String?
  signedAttachment String?
  createdById    Int
  createdBy      User          @relation("ReceiptCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum ProjectType {
  CONSTRUCTION
  DEVELOPMENT
  PROTECTION
}

enum ProjectStatus {
  STUDY
  WORK
  COMPLETED
  SUSPENDED
}

model Project {
  id                  Int           @id @default(autoincrement())
  name                String
  type                ProjectType
  status              ProjectStatus @default(STUDY)
  entityId            Int
  entity              Entity        @relation(fields: [entityId], references: [id])
  progress            Int           @default(0)        // 0-100 %
  budget              Float
  budgetYear          Int
  extraBudget         Float?
  extraBudgetYear     Int?
  startDate           DateTime?
  expectedEndDate     DateTime?
  notes               String?
  securityUnit        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  adminNumber     String        @unique
  vehicleType     String?       // نوع الوسيلة: نص حر (مثال: غزوال بيك آب، P4)
  type            String        // صنف الوسيلة: "وسيلة نقل إدارية" | "مضخة مياه" | إلخ
  fuelType        String        // نوع الوقود: "بنزين رفيع" | "غزوال"
  fuelQuota       Float?        // المقرر بالتر
  status          VehicleStatus @default(OPERATIONAL) // حالة الوسيلة
  breakdownRef    String?       // رقم برقية التعطب
  breakdownDate   DateTime?     // تاريخ برقية التعطب
  entity          Entity        @relation(fields: [entityId], references: [id])
  entityId        Int
  notes           String?
  securityUnit    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
